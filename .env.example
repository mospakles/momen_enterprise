# URL the browser uses to reach the Nest API. Do not put server secrets here.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Public address of the storefront. Set to https://momenclothing.com only on the
# live service: anything else is treated as staging and hidden from search engines.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional private address the storefront server uses to reach the API.
# Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=""
