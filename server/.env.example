# Local Postgres connection. Point this at a real database before running
# `npx prisma migrate dev` — see README for setup options (Docker, Postgres.app,
# or a hosted instance).
DATABASE_URL="postgresql://momen:momen@localhost:5432/momen?schema=public"

# JWT signing secret for access tokens — replace with a real random value
# outside development. Refresh tokens are opaque random values stored only
# as a hash (see common/utils/token.util.ts), not signed JWTs, so there's no
# separate refresh secret to configure.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"

PORT=4000

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN="http://localhost:3000"

# Paystack test secret key — get one from https://dashboard.paystack.com/#/settings/developer
# Only PaystackProvider reads this; never referenced from business logic
# directly (see payments/providers/payment-provider.interface.ts).
PAYSTACK_SECRET_KEY="sk_test_replace_me"
