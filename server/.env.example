# Database
DATABASE_URL="postgresql://momen:momen@localhost:5432/momen?schema=public"

# JWT signing secret for access tokens — replace with a real random value
# outside development. Refresh tokens are opaque random values stored only
# as a hash (see common/utils/token.util.ts), not signed JWTs, so there's no
# separate refresh secret to configure.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL="15m"

PORT=4000
NODE_ENV="development"

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
# `none` requires HTTPS. Use `lax` for local development and same-site deployments.
AUTH_COOKIE_SAME_SITE="lax"

# Payments
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_CALLBACK_URL="http://localhost:3000/checkout/payment-callback"

# Outbound mail (Resend). In development, email bodies are logged if these are omitted.
RESEND_API_KEY=""
EMAIL_FROM="Momen <hello@example.com>"
SUPPORT_EMAIL="hello@example.com"

# Required only when creating the very first administrator with `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="use-a-unique-long-password"
# Optional display name for that administrator.
SEED_ADMIN_NAME=""
# Sample catalog, delivery zone, coupon and tailor. Defaults to true outside
# NODE_ENV=production and false in production.
SEED_SAMPLE_DATA=""

# Flutterwave (optional second payment provider). Webhook URL:
# <API>/api/payments/webhooks/flutterwave — set the same secret hash here.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Google Places API (New) key for checkout address autocomplete (optional).
GOOGLE_PLACES_API_KEY=
